#!/usr/bin/env python3
"""On the Linux server, deploy main only after its exact commit passes CI."""

import fcntl
import json
import os
from pathlib import Path
import subprocess
import sys
import urllib.parse
import urllib.request


def run(*args, cwd=None, env=None):
    subprocess.run(args, cwd=cwd, env=env, check=True)


def revision(source):
    run("git", "fetch", "--depth", "1", "origin", "main", cwd=source)
    return subprocess.check_output(["git", "rev-parse", "FETCH_HEAD"], cwd=source, text=True).strip()


def deploy(root):
    source = root / "auto-source"
    deployed = root / "deployed-revision"
    if not (source / ".git").exists():
        remote = os.environ.get("WRAP_GIT_REMOTE", "https://github.com/rossvz/wrap.git")
        run("git", "clone", "--no-checkout", remote, str(source))
    candidate = revision(source)
    if deployed.exists() and deployed.read_text().strip() == candidate:
        print(f"Already deployed {candidate}")
        return

    query = urllib.parse.urlencode({"branch": "main", "event": "push", "head_sha": candidate, "per_page": 1})
    api = os.environ.get("WRAP_GITHUB_API_URL", "https://api.github.com").rstrip("/")
    request = urllib.request.Request(
        f"{api}/repos/rossvz/wrap/actions/workflows/ci.yml/runs?{query}",
        headers={"Accept": "application/vnd.github+json", "User-Agent": "Wrap-home-deployment"},
    )
    with urllib.request.urlopen(request, timeout=30) as response:
        runs = json.load(response).get("workflow_runs", [])
    latest = runs[0] if runs else {}
    expected = {"head_sha": candidate, "head_branch": "main", "event": "push",
                "status": "completed", "conclusion": "success"}
    if any(latest.get(key) != value for key, value in expected.items()):
        print(f"Waiting for successful CI on {candidate}: {latest.get('status', 'no run')} / {latest.get('conclusion')}")
        return

    run("git", "checkout", "--detach", "--force", candidate, cwd=source)
    run("docker", "build", "-t", "wrap:home", ".", cwd=source)
    if revision(source) != candidate:
        print("Main changed during the build; leaving the live app unchanged until the next check")
        return
    env = dict(os.environ, WRAP_DEPLOY_LOCKED="1", WRAP_DEPLOY_REVISION=candidate)
    run("bin/start-home", cwd=source, env=env)
    temporary = root / "deployed-revision.tmp"
    temporary.write_text(candidate + "\n")
    temporary.replace(deployed)
    print(f"Deployed {candidate} to https://wrap.rossvz.com", flush=True)


def main():
    root = Path(os.environ.get("WRAP_HOME_ROOT", str(Path.home() / "apps/wrap")))
    root.mkdir(parents=True, exist_ok=True)
    with (root / "deploy.lock").open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print("Another deployment is in progress")
            return
        deploy(root)


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        print(f"Deployment check failed: {error}", file=sys.stderr)
        sys.exit(1)
